{
  "name": "golive-mcp",
  "version": "1.0.0",
  "description": "Check a site is ready before you share the link. Link previews for LinkedIn, X, Slack, iMessage and Discord, SPA refresh 404s, security headers, favicons, noindex left on. MCP server and CLI, no API key.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "open-graph",
    "og-image",
    "link-preview",
    "social-preview",
    "twitter-card",
    "seo",
    "security-headers",
    "vercel",
    "spa",
    "launch-checklist",
    "claude"
  ],
  "author": "Myan Patel (https://github.com/myanptl)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "golive-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.myanptl/golive-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myanptl/golive-mcp.git"
  },
  "homepage": "https://github.com/myanptl/golive-mcp#readme",
  "bugs": {
    "url": "https://github.com/myanptl/golive-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
